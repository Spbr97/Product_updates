# Copy to .env and adjust. .env is gitignored -- never commit real credentials.

# --- Database (required) -----------------------------------------------------------
# Matches the docker-compose development database.
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Used by the test suite. Point it at a THROWAWAY database: tests create and drop tables.
TEST_DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker_test

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=INFO
# json for production, console for readable local output.
LOG_FORMAT=console

# --- Scheduling --------------------------------------------------------------------
# Default seconds between checks for a product that does not override it.
CHECK_INTERVAL_SECONDS=3600
RECONCILE_INTERVAL_SECONDS=60

# --- Outbound HTTP -----------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=3

# --- Delivery location ---------------------------------------------------------------
# Indian shops price and stock per delivery area, so "the price" has a location in it.
# Leave blank and every check takes whatever the shop's default area returns -- quietly.
# Set a six-digit PIN and a shop that prices per area but cannot be localised without a
# browser session records `needs_location` (a `partial` check) instead of passing off a
# price from somewhere else. No shop can be localised statically today; see
# src/product_tracker/stores/pincode.py for which are classified how, and why.
DELIVERY_PINCODE=

# --- Politeness towards stores -----------------------------------------------------
# Minimum gap between two requests to the same store, plus random jitter on top.
STORE_MIN_INTERVAL_SECONDS=5
FETCH_JITTER_SECONDS=3
STORE_FAILURE_THRESHOLD=5
STORE_CIRCUIT_RESET_SECONDS=900

# --- Search ------------------------------------------------------------------------
# A shop's catalogue lists URLs, not prices, so hits found that way arrive priceless.
# This many of the best ones get their product page fetched so the result is a real
# comparison. Each lookup is one paced request: a direct trade of latency for
# usefulness. 0 switches it off.
SEARCH_PRICE_LOOKUPS=5

# --- Playwright --------------------------------------------------------------------
# Requires the browser extra: pip install -e ".[browser]" && playwright install chromium
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_SECONDS=25

# --- API ---------------------------------------------------------------------------
# Leave blank to disable auth (fine for a local-only instance). If set, mutating
# endpoints require the header: X-API-Key: <value>
# Accepts a comma-separated list, so a key can be rotated with no downtime:
# add the new one, redeploy, move clients over, then drop the old one.
API_KEY=
API_ALLOW_ANONYMOUS_READS=true
# Reject request bodies larger than this (bytes).
API_MAX_REQUEST_BYTES=64000
# State-changing requests per client per minute, and the burst allowance.
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=20

# --- URL safety --------------------------------------------------------------------
# SSRF guard. Only turn this off if you deliberately need to track an internal host.
BLOCK_PRIVATE_ADDRESSES=true
ALLOWED_URL_SCHEMES=https,http

# --- Notifications -----------------------------------------------------------------
# Comma-separated, tried in order; the first that delivers wins.
# Available: console, email, telegram, webhook.
NOTIFY_DEFAULT_PROVIDERS=console
# Per-provider delivery timeout in seconds.
NOTIFICATION_TIMEOUT_SECONDS=10
# How long the same alert is suppressed for. Shorten for volatile prices.
NOTIFICATION_DEDUPE_WINDOW_SECONDS=86400

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook (Slack and Discord incoming webhooks work here)
WEBHOOK_URL=

# --- Reserved ----------------------------------------------------------------------
# Unused in v1. Present for a future Celery/RQ JobQueue implementation.
REDIS_URL=
