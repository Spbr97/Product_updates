# Copy to .env and adjust. .env is gitignored -- never commit real credentials.

# --- Database (required) -----------------------------------------------------------
# Matches the docker-compose development database.
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Used by the test suite. Point it at a THROWAWAY database: tests create and drop tables.
TEST_DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker_test

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=INFO
# json for production, console for readable local output.
LOG_FORMAT=console

# --- Scheduling --------------------------------------------------------------------
# Default seconds between checks for a product that does not override it.
CHECK_INTERVAL_SECONDS=3600
RECONCILE_INTERVAL_SECONDS=60

# --- Outbound HTTP -----------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=3

# --- Politeness towards stores -----------------------------------------------------
# Minimum gap between two requests to the same store, plus random jitter on top.
STORE_MIN_INTERVAL_SECONDS=5
FETCH_JITTER_SECONDS=3
STORE_FAILURE_THRESHOLD=5
STORE_CIRCUIT_RESET_SECONDS=900

# --- Playwright --------------------------------------------------------------------
# Requires the browser extra: pip install -e ".[browser]" && playwright install chromium
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_SECONDS=25

# --- API ---------------------------------------------------------------------------
# Leave blank to disable auth (fine for a local-only instance). If set, mutating
# endpoints require the header: X-API-Key: <value>
API_KEY=
API_ALLOW_ANONYMOUS_READS=true

# --- URL safety --------------------------------------------------------------------
# SSRF guard. Only turn this off if you deliberately need to track an internal host.
BLOCK_PRIVATE_ADDRESSES=true
ALLOWED_URL_SCHEMES=https,http

# --- Notifications -----------------------------------------------------------------
# Comma-separated, tried in order; the first that delivers wins.
# Available: console, email, telegram, webhook.
NOTIFY_DEFAULT_PROVIDERS=console
# Per-provider delivery timeout in seconds.
NOTIFICATION_TIMEOUT_SECONDS=10

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook (Slack and Discord incoming webhooks work here)
WEBHOOK_URL=

# --- Reserved ----------------------------------------------------------------------
# Unused in v1. Present for a future Celery/RQ JobQueue implementation.
REDIS_URL=
